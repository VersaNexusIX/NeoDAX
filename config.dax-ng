[meta]
name        = NeoDAX
version     = 1.0.8
codename    = Vera
author      = VersaNexusIX
license     = Apache-2.0
repo        = https://github.com/VersaNexusIX/NeoDAX
tagline     = Binary Analysis & Reverse Engineering Tool

[logo]
line1 = \033[1;34m  ╔═══╗\033[0m \033[1;33m ███╗   ██╗███████╗ ██████╗\033[0m
line2 = \033[1;34m  ║ █ ║\033[0m \033[1;33m ████╗  ██║██╔════╝██╔═══██╗\033[0m
line3 = \033[1;34m  ║ █ ║\033[0m \033[1;33m ██╔██╗ ██║█████╗  ██║   ██║\033[0m
line4 = \033[1;34m  ║ █ ║\033[0m \033[1;33m ██║╚██╗██║██╔══╝  ██║   ██║\033[0m
line5 = \033[1;34m  ║ █ ║\033[0m \033[1;33m ██║╚██╗██║██╔══╝  ██║   ██║\033[0m
line5 = \033[1;34m  ║ █ ║\033[0m \033[1;33m ██║ ╚████║███████╗╚██████╔╝
line7 = \033[1;34m  ╚═══╝\033[0m \033[1;33m ╚═╝  ╚═══╝╚══════╝ ╚═════╝\033[0m

[build]
success_msg = built successfully
banner_width = 72

[colors]
reset   = \033[0m
bold    = \033[1m
addr    = \033[1;34m
mnem    = \033[1;37m
ops     = \033[0;36m
label   = \033[1;36m
comment = \033[0;90m
section = \033[1;32m
entry   = \033[1;35m
meta    = \033[0;35m
warn    = \033[1;33m
error   = \033[1;31m
green   = \033[1;32m

[daxc]
format_version  = 4
magic           = NEOX
extension       = .daxc
description     = NeoDAX Analysis Snapshot — AOT C source, compilable by GCC/Clang
compile_hint    = clang -O2 -o snapshot <file.daxc>
run_hint        = ./snapshot
load_hint       = neodax <file.daxc>

[server]
port            = 7070
host            = 127.0.0.1
max_body_bytes  = 5242880

[emulator]
max_steps       = 65536
call_depth      = 64
stack_size      = 0x80000
heap_base       = 0x20000000
heap_max        = 0x10000000
page_size       = 4096
pages           = 256
